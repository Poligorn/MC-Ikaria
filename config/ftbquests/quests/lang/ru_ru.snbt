{
	chapter.2AAF5935EA1DE955.title: "Камень и три имени"
	chapter.C10A2B3C4D5E6F70.title: "След Элиаса"
	chapter.C20B3C4D5E6F7081.title: "След Кайры"
	chapter.C30C4D5E6F708192.title: "След Рована"
	file.0000000000000001.title: "Мой журнал"
	quest.3364BA01A0AF91D8.title: "Проснулся на камне"
	quest.3364BA01A0AF91D8.quest_desc: [
		"Камень под боком. Внизу — ничего. Ветер пишет первым."
		""
		"Три имени крутятся, будто я их уже читал: Элиас Верн, Кайра Шторм, Рован Пепельный. Их дневников при мне нет. Обложки сами в карман не лягут — их надо искать в сундуках по островам."
		""
		"Что они встретили — не написано. Пока ставлю черту: иду искать."
	]
	quest.D1E94A01B0C18273.title: "Почерк линейки"
	quest.D1E94A01B0C18273.quest_subtitle: "Элиас Верн"
	quest.D1E94A01B0C18273.quest_desc: [
		"Элиас пишет так, будто цифра важнее сна. Ищу обложку «Чертежи Механика» — одну. Вторую не возьму."
		""
		"Линейка оборвана на полуслове. Что он мерил в тот миг — ещё не знаю."
	]
	quest.D2F05B12C1D29384.title: "Вахта не сдана"
	quest.D2F05B12C1D29384.quest_subtitle: "Кайра Шторм"
	quest.D2F05B12C1D29384.quest_desc: [
		"Кайра оставляет высоту и ветер, не прощание. Ищу «Бортовой журнал Небохода» в сундуке. Один том."
		""
		"Последняя цифра высоты не сходится сама с собой. Почему — она не дописала."
	]
	quest.D3016C23D2E3A495.title: "Карточка без имени"
	quest.D3016C23D2E3A495.quest_subtitle: "Рован Пепельный"
	quest.D3016C23D2E3A495.quest_desc: [
		"Рован ставит точки, не имена. Ищу «Полевой дневник Следопыта». Один. Чужой второй не нужен."
		""
		"След есть. Зверя нет. Что смотрело — он не назвал."
	]
	quest.7E4A1C90B2D83F61.title: "Мешок на краю"
	quest.7E4A1C90B2D83F61.quest_subtitle: "Оболочка и горелка"
	quest.7E4A1C90B2D83F61.quest_desc: [
		"На краю висит мешок. Оболочка ещё держит форму. Под ней костры, не горелка. Кто бросил корзину — из тех троих или раньше — не знаю."
		""
		"Сниму восемь кусков оболочки. В бочонках корзины лежат листы, сплав, пыль и блок угля — соберу горелку на верстаке из досок. Готовой горелки нет. Поставлю свою под мешок вместо костров."
	]
	quest.9A6C3E12D4F05184.title: "Рычаг, без которого мешок не живой"
	quest.9A6C3E12D4F05184.quest_subtitle: "Physics Assembler"
	quest.9A6C3E12D4F05184.quest_desc: [
		"Мешок без сборки — просто ткань на ветру. Нужен Physics Assembler: рычаг, два сплава, андезитовый корпус."
		""
		"Сплав и корпуса лежат в тех же бочонках. Рычаг — там же, или из булыжника и палки. Соберу на верстаке. Без станков Create."
	]
	quest.9B7D4F23E5016295.title: "Винт вместо пустого вала"
	quest.9B7D4F23E5016295.quest_subtitle: "Андезитовый пропеллер"
	quest.9B7D4F23E5016295.quest_desc: [
		"Три вала торчат мёртвые. Им нужен андезитовый пропеллер: готовый винт Create, деревянная плита, вал."
		""
		"Винты и валы — в бочонках. Плиту сниму с дуба на площадке. Соберу и поставлю, пока мешок ещё держит воздух."
	]
	quest.8F5B2D01C3E94072.title: "Крыло, пока нет корабля"
	quest.8F5B2D01C3E94072.quest_subtitle: "Аэролит и параглайдер"
	quest.8F5B2D01C3E94072.quest_desc: [
		"Слезть с камня можно раньше, чем починить мешок. Отдельного «крыла аэролита» в паке нет — крыло шьётся из прутиков аэролита. Три штуки и четыре палки."
		""
		"Прутик падает с руды на острове. В бочонках тоже лежат обрывки. Кожу не ищу — тот рецепт снят. Соберу параглайдер."
	]
	quest.E1A17D34E3F4B5A6.title: "Вырванная кинетика"
	quest.E1A17D34E3F4B5A6.quest_desc: [
		"У Элиаса не хватает листа «кинетика». Ищу один. Когда ляжет в том — эта запись закрыта."
	]
	quest.E2B28E45F405C6B7.title: "Вырванные станки"
	quest.E2B28E45F405C6B7.quest_desc: [
		"Лист про станки вынут из тетради Элиаса. Один. Без него пресс и мельница в его почерке не читаются."
	]
	quest.E3C39F560516D7C8.title: "Вырванные сплавы"
	quest.E3C39F560516D7C8.quest_desc: [
		"Сплавы он считал до последнего. Лист один. Найду — и эта глава его дневника снова цела."
	]
	quest.E4D4A0671627E8D9.title: "Вырванный планёр"
	quest.E4D4A0671627E8D9.quest_desc: [
		"Кайра писала про личный полёт. Лист вырван. Ищу один — её вахту про планёр."
	]
	quest.E5E5B1782738F9EA.title: "Вырванный корпус"
	quest.E5E5B1782738F9EA.quest_desc: [
		"Страница про корпус корабля. Одной довольно. Вторую не возьму."
	]
	quest.E6F6C28938490AFB.title: "Вырванное небо"
	quest.E6F6C28938490AFB.quest_desc: [
		"Её небо оборвано на полуслове. Найду лист — и дочитаю, сколько она успела."
	]
	quest.E707D39A495A1B0C.title: "Вырванные звери"
	quest.E707D39A495A1B0C.quest_desc: [
		"Карточки зверей Рована рассеяны. Нужна одна — глава «звери»."
	]
	quest.E818E4AB5A6B2C1D.title: "Вырванные дыры"
	quest.E818E4AB5A6B2C1D.quest_desc: [
		"Он знал край портала. Лист про дыры — один. Что смотрело между листьями, он всё равно не назвал."
	]
	quest.E929F5BC6B7C3D2E.title: "Вырванные руины"
	quest.E929F5BC6B7C3D2E.quest_desc: [
		"Руины у него без карты. Ищу один лист. Дальше пойду по его следу, не по чужому."
	]
	task.3D9CC80F7EADD53D.title: "Иду искать"
	task.F411A001B0C18201.title: "Обложка Элиаса"
	task.F422B112C1D29302.title: "Обложка Кайры"
	task.F433C223D2E3A403.title: "Обложка Рована"
	task.91A63E12D4FA5183.title: "Восемь кусков оболочки"
	task.A2B74F23E50B6294.title: "Горелка горячего воздуха"
	task.F1A63E12D4FA5101.title: "Physics Assembler"
	task.F2B74F23E50B6202.title: "Андезитовый пропеллер"
	task.F3C85034F61C7303.title: "Три прутика аэролита"
	task.B3C85034F61C73A5.title: "Параглайдер"
	task.F511A17D34E3F401.title: "Лист: кинетика"
	task.F522B28E45F40502.title: "Лист: станки"
	task.F533C39F56051603.title: "Лист: сплавы"
	task.F544D4A067162704.title: "Лист: планёр"
	task.F555E5B178273805.title: "Лист: корпус"
	task.F566F6C289384906.title: "Лист: небо"
	task.F57707D39A495A07.title: "Лист: звери"
	task.F58818E4AB5A6B08.title: "Лист: дыры"
	task.F59929F5BC6B7C09.title: "Лист: руины"
}
